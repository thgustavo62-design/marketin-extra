# Conexão direta ao Postgres (só servidor). Nunca expor ao navegador.
DATABASE_URL=
# Opcional: validade da sessão em horas (padrão 12)
SESSION_TTL_HOURS=12
# Windsor.ai (métricas de Instagram/anúncios) — só servidor
