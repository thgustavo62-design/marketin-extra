# Opcional: certificado (PEM) do Supabase para validar a conexão com o banco
DATABASE_CA=

# Studio: opcionais; modelos Replicate compatíveis com input prompt / image
REPLICATE_API_TOKEN=
REPLICATE_GENERATE_VERSION=
REPLICATE_REMOVE_BG_VERSION=

# Hierarquia 037: conexão comercial restrita, provisionada no corte coordenado.
# Nunca reutilizar o login privilegiado de DATABASE_URL neste campo.
DATABASE_RUNTIME_URL=
# Referência do projeto Supabase correto (somente para o inventário de leitura).
NOVA7_PROJECT_REF=
