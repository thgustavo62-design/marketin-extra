{
  "name": "extra-marketing",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types \"tests/*.test.ts\"",
    "db:migrate": "node --env-file=.env scripts/migrate.mjs",
    "db:seed-admin": "node --env-file=.env scripts/seed-admin.mjs",
    "e2e": "node --env-file=.env e2e/run.mjs",
    "e2e:rapido": "node --env-file=.env e2e/run.mjs --skip net,windsor"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "lucide-react": "^1.54.0",
    "next": "^16.4.0",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "unpdf": "^1.8.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "embedded-postgres": "^18.4.0-beta.17",
    "playwright-core": "^1.64.1",
    "typescript": "^7.0.2"
  }
